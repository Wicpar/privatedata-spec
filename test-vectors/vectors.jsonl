{"id":"delivered-secret-commitment-001","description":"nym_auth delivered secret: SHA256(secret_seed) must equal the issuer-signed ssc","version":"3","sections":["5A"],"tags":["delivered-secret","commitment"],"inputs":{"secret_seed_hex":"00112233445566778899aabbccddeeff","cases":[{"name":"match","ssc_hex":"a8faed6abbf35c12a4b26e40f6feb19d736d90045c83b9f9a31f638d323e6811","expected":"accept: store secret_seed in credential metadata"},{"name":"mismatch","ssc_hex":"5e66b056f4c3f475f5c86031ca95f285fd7be88bf2682044f723789531c99ee7","expected":"failed issuance: do not store, do not use"}]},"expected":{"ssc_hex_for_match":"a8faed6abbf35c12a4b26e40f6feb19d736d90045c83b9f9a31f638d323e6811","credentialAfterAccept":{"id":"cred-001","format":"dc+sd-jwt","kid":"2026-10-key-001","instanceId":"instance-uuid-001","batchId":"batch-2026-10-01","credentialIssuerIdentifier":"https://issuer.example.com","credentialConfigurationId":"org.siros.nym_auth","metadata":[{"type":"org.siros.NS.secret_seed","value":"00112233445566778899aabbccddeeff"}]}},"validations":{"commitment":"SHA256(bytes.fromhex(secret_seed_hex)) MUST equal ssc_hex before storing and again before use","mismatch":"a mismatch MUST be treated as a failed issuance"}}
